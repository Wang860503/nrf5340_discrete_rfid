/*
 * DK 上 Arduino A0/A1 = P0.04/P0.05 = SAADC 與內建 COMP 的 AIN0/AIN1 同源。
 * 若同時啟用 &adc，常見現象是 COMP 讀值不變、raw_edges 永遠 0。
 */
&adc {
    status = "disabled";
};

&pwm0 {
    /* 載波改由 main.c 的 TIMER+DPPI+GPIOTE 驅動，避免與 P1.09/P1.10 衝突 */
    status = "disabled";
    pinctrl-0 = <&pwm0_default>;
    pinctrl-1 = <&pwm0_sleep>;
    pinctrl-names = "default", "sleep";
};

&pinctrl {
    pwm0_default: pwm0_default {
        group1 {
            /* 修改點：從 Port 0 改為 Port 1 */
            psels = <NRF_PSEL(PWM_OUT0, 1, 9)>,   /* P1.09 */
                    <NRF_PSEL(PWM_OUT1, 1, 10)>;  /* P1.10 */
            nordic,drive-mode = <NRF_DRIVE_H0H1>;
        };
    };

    pwm0_sleep: pwm0_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 1, 9)>,   /* P1.09 */
                    <NRF_PSEL(PWM_OUT1, 1, 10)>;  /* P1.10 */
            low-power-enable;
        };
    };
};

&comp {
    status = "okay";
    main-mode = "SE";       /* 單端模式：比較 psel 與內部參考 */
    psel = "AIN2";          /* 對應 P0.06，接 RFID 訊號 */
    refsel = "VDD";         /* 內部分壓參考（VDD ladder） */
    th-down = <23>;         /* 約 33/64 * VDD */
    th-up = <25>;           /* 約 35/64 * VDD */
    sp-mode = "HIGH";       /* 高速模式 */
    enable-hyst;            /* 保留遲滯 */
    isource = "DISABLED";   /* 關閉內部電流源 */
};
