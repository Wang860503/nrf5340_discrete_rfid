/*
 * DK 上 Arduino A0/A1 = P0.04/P0.05 = SAADC 與內建 COMP 的 AIN0/AIN1 同源。
 * 若同時啟用 &adc，常見現象是 COMP 讀值不變、raw_edges 永遠 0。
 */
&adc {
    status = "disabled";
};

&pwm0 {
    /* 載波改由 main.c 的 nrfx_pwm 直接驅動，避免 Zephyr PWM 驅動重複占用 pin */
    status = "disabled";
    pinctrl-0 = <&pwm0_default>;
    pinctrl-1 = <&pwm0_sleep>;
    pinctrl-names = "default", "sleep";
};

&pinctrl {
    pwm0_default: pwm0_default {
        group1 {
            /* 修改點：從 Port 0 改為 Port 1 */
            psels = <NRF_PSEL(PWM_OUT0, 1, 9)>,   /* P1.09 */
                    <NRF_PSEL(PWM_OUT1, 1, 10)>;  /* P1.10 */
            nordic,drive-mode = <NRF_DRIVE_S0S1>;
        };
    };

    pwm0_sleep: pwm0_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 1, 9)>,   /* P1.09 */
                    <NRF_PSEL(PWM_OUT1, 1, 10)>;  /* P1.10 */
            low-power-enable;
        };
    };
};

/*
 * RFID_COMP_USE_NRFX_DIRECT=1 時由 main.c nrfx_comp 獨占，須 disabled 避免與 Zephyr 驅動搶 COMP。
 * nrfx 路徑：AIN0(P0.04)=CMP_P 慢路(TP2)、AIN1(P0.05)=CMP_N 快路(TP3)，DIFF。
 * 對齊 Mavericks/EFR32 ACMP0：快/慢包絡交叉 → DEMOD_OUT；非 125kHz 雙載波。
 * RFID_COMP_DIRECT_EDGE_DECODE=1：COMP 邊緣間隔直接作 Manchester 半週期。
 */
&comp {
    status = "disabled";
};
