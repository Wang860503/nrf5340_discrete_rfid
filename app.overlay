/*
 * DK 上 Arduino A0/A1 = P0.04/P0.05 = SAADC 與內建 COMP 的 AIN0/AIN1 同源。
 * 若同時啟用 &adc，常見現象是 COMP 讀值不變、raw_edges 永遠 0。
 */
&adc {
    status = "disabled";
};

&pwm0 {
    status = "okay";
    pinctrl-0 = <&pwm0_default>;
    pinctrl-1 = <&pwm0_sleep>;
    pinctrl-names = "default", "sleep";
};

&pinctrl {
    pwm0_default: pwm0_default{
        group1{
            psels = <NRF_PSEL(PWM_OUT0, 0, 25)>,
                    <NRF_PSEL(PWM_OUT1, 0, 26)>;
            nordic,drive-mode = <NRF_DRIVE_H0H1>;
        };
    };

    pwm0_sleep: pwm0_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 25)>,
                    <NRF_PSEL(PWM_OUT1, 0, 26)>;
            low-power-enable;
        };
    };
};

&comp {
    status = "okay";
    /*
     * 差動輸入（對應廠商「兩腳位比較器」概念）：
     *   psel = AIN0 → 通常對 P0.04，作正端
     *   extrefsel = AIN1 → 通常對 P0.05，作負端
     * 綁定 nordic,nrf-comp 只接受 main-mode "SE"|"DIFF"（不可用 "differential"）、
     * sp-mode（非 speed-mode）、enable-hyst（非 hysteresis 字串）、isource 須大寫 "DISABLED"。
     */
    main-mode = "DIFF";
    /* 與註解一致：P0.04 / P0.05。若實際走線是 P0.06 / P0.07 請改 AIN2 / AIN3 */
    psel = "AIN2";
    extrefsel = "AIN3";
    sp-mode = "HIGH";
    enable-hyst;
    isource = "DISABLED";
};
